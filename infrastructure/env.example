# ==========================================
# NextMail AI Environment Configuration Template
# ==========================================

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nextmail_db
SPRING_DATASOURCE_USERNAME=nextmail_user
SPRING_DATASOURCE_PASSWORD=nextmail_secret

# Cache (Redis)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Search (Elasticsearch)
ELASTICSEARCH_URIS=http://localhost:9200

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ATTACHMENTS=nextmail-attachments
S3_BUCKET_RAW_MAIL=nextmail-raw-mail

# Mail Gateway (GreenMail Local Mock / External Provider)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=3025
SPRING_MAIL_USERNAME=test@nextmail.local
SPRING_MAIL_PASSWORD=secret
IMAP_HOST=localhost
IMAP_PORT=3143
IMAP_SSL=false

# Security & JWT
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days

# AI Gateway (Google Gemini / OpenAI / Ollama)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
